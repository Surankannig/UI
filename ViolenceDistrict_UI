                    pImg.Visible = true
                    pLbl.Position = UDim2.fromOffset(30, 2)
                    pLbl.Size = UDim2.new(1, -32, 1, -4)
                else
                    pImg.Visible = false
                    pLbl.Position = UDim2.fromOffset(4, 2)
                    pLbl.Size = UDim2.new(1, -8, 1, -4)
                end
                pLbl.Text = pName
                pLbl.TextColor3 = Color3.fromRGB(240, 245, 250)
            else
                pImg.Visible = false
                pLbl.Position = UDim2.fromOffset(4, 2)
                pLbl.Size = UDim2.new(1, -8, 1, -4)
                pLbl.Text = "---"
                pLbl.TextColor3 = Window.Theme.SubText
            end
        end

        local itemName, itemDet, itemCol = GetRosterItemDisplay(plr, isK)
        row.ItemNameLabel.Text = itemName or "No Item"
        row.ItemDetLabel.Text = itemDet or "---"
        row.ItemDetLabel.TextColor3 = itemCol or Window.Theme.SubText

        if isK then
            row.ItemHeader.Visible = false
            row.ItemBox.Visible = false
        else
            row.ItemHeader.Visible = true
            row.ItemBox.Visible = true
            local itIcon = GetItemIcon(itemName)
            if itIcon and itIcon ~= "" and itemName ~= "No Item" and itemName ~= "None" then
                row.ItemImg.Image = itIcon
                row.ItemImg.Visible = true
                row.ItemNameLabel.Position = UDim2.fromOffset(42, 4)
                row.ItemNameLabel.Size = UDim2.new(1, -44, 0, 16)
                row.ItemDetLabel.Position = UDim2.fromOffset(42, 21)
                row.ItemDetLabel.Size = UDim2.new(1, -44, 0, 15)
            else
                row.ItemImg.Visible = false
                row.ItemNameLabel.Position = UDim2.fromOffset(8, 4)
                row.ItemNameLabel.Size = UDim2.new(1, -12, 0, 16)
                row.ItemDetLabel.Position = UDim2.fromOffset(8, 21)
                row.ItemDetLabel.Size = UDim2.new(1, -12, 0, 15)
            end
        end
    end)
    if not ok then
        warn("Nexara: Roster render error for player " .. tostring(plr) .. ": " .. tostring(err))
    end
end

    colRoster.Frame.CanvasSize = UDim2.new(0, 0, 0, 50 + (#ordered * 78))
end


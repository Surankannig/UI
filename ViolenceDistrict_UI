                if nm:find("^Section_") or nm == "CustomCard" or nm == "TopCategoryNav" or nm == "TopAutoNav" or nm == "RosterHeaderCard" or nm:find("^PlayerCard_") then
                    desc.BackgroundColor3 = pal.Surface

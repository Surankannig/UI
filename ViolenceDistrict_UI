        warnSlideOffset = warnSlideOffset + (10 - warnSlideOffset) * math.clamp(dt * 12, 0, 1)
    end

    if warnAlpha <= 0.01 then
        if LegitWarnBanner.Visible then LegitWarnBanner.Visible = false end
        return
    end

    if not LegitWarnBanner.Visible then
        LegitWarnBanner.Visible = true

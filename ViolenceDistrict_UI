            },
            {
                Origin = Vector2.new(winW * 0.78, winH * 0.24),
                Nodes = {
                    { rel = Vector2.new(-38, -22), isMajor = true },
                    { rel = Vector2.new(-8, -4) },
                    { rel = Vector2.new(26, 16), isMajor = true },
                    { rel = Vector2.new(-24, 18) },
                    { rel = Vector2.new(10, -24) },
                },
                Pairs = { {1, 2}, {2, 3}, {4, 2}, {2, 5} }
            },
            {
                Origin = Vector2.new(winW * 0.68, winH * 0.74),
                Nodes = {
                    { rel = Vector2.new(-46, 18), isMajor = true },

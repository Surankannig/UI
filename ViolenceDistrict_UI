                Origin = Vector2.new(winW * 0.16, winH * 0.72),
                Nodes = {
                    { rel = Vector2.new(-36, 16) },
                    { rel = Vector2.new(-18, 2) },
                    { rel = Vector2.new(4, -6), isMajor = true },
                    { rel = Vector2.new(26, 4) },
                    { rel = Vector2.new(38, 18) },
                },
                Pairs = { {1, 2}, {2, 3}, {3, 4}, {4, 5} }
            }
        }

        local function makeCrossStar(pos, sz)
            local flare = Instance.new("Frame")
            flare.Size = UDim2.fromOffset(sz, sz)
            flare.Position = UDim2.fromOffset(pos.X, pos.Y)
            flare.AnchorPoint = Vector2.new(0.5, 0.5)
            flare.BackgroundTransparency = 1
            flare.ZIndex = 5
            flare.Active = false
            flare.Parent = spaceContainer

            local rV = Instance.new("Frame")
            rV.Size = UDim2.fromOffset(1, sz)
            rV.Position = UDim2.fromScale(0.5, 0.5)
            rV.AnchorPoint = Vector2.new(0.5, 0.5)
            rV.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            rV.BackgroundTransparency = 0.35
            rV.BorderSizePixel = 0
            rV.ZIndex = 5
            rV.Parent = flare
            Instance.new("UICorner", rV).CornerRadius = UDim.new(1, 0)

            local rH = Instance.new("Frame")
            rH.Size = UDim2.fromOffset(sz, 1)
            rH.Position = UDim2.fromScale(0.5, 0.5)
            rH.AnchorPoint = Vector2.new(0.5, 0.5)
            rH.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            rH.BackgroundTransparency = 0.35
            rH.BorderSizePixel = 0
            rH.ZIndex = 5
            rH.Parent = flare
            Instance.new("UICorner", rH).CornerRadius = UDim.new(1, 0)

            table.insert(rwCrossStars, { Frame = flare, RayV = rV, RayH = rH, BasePulse = sz, Speed = math.random(6, 12) })
        end

        for _, cDef in ipairs(constDefs) do
            local pts = {}
            for idx, nd in ipairs(cDef.Nodes) do
                local nPos = cDef.Origin + nd.rel
                pts[idx] = nPos
                local dSz = nd.isMajor and 2.5 or 2
                local dot = Instance.new("Frame")
                dot.Size = UDim2.fromOffset(dSz, dSz)
                dot.Position = UDim2.fromOffset(nPos.X, nPos.Y)
                dot.AnchorPoint = Vector2.new(0.5, 0.5)
                dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                dot.BackgroundTransparency = nd.isMajor and 0.05 or 0.25
                dot.BorderSizePixel = 0
                dot.ZIndex = 4
                dot.Active = false
                dot.Parent = spaceContainer
                Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

                if nd.isMajor then
                    makeCrossStar(nPos, 11)
                end
            end
            for _, pr in ipairs(cDef.Pairs) do
                local p1, p2 = pts[pr[1]], pts[pr[2]]
                if p1 and p2 then
                    local dist = (p2 - p1).Magnitude
                    local angle = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
                    local lf = Instance.new("Frame")
                    lf.BorderSizePixel = 0
                    lf.AnchorPoint = Vector2.new(0.5, 0.5)
                    lf.BackgroundColor3 = lineCol
                    lf.BackgroundTransparency = 0.78
                    lf.Size = UDim2.fromOffset(dist, 1)
                    lf.Position = UDim2.fromOffset((p1.X + p2.X) * 0.5, (p1.Y + p2.Y) * 0.5)
                    lf.Rotation = angle
                    lf.ZIndex = 2
                    lf.Active = false
                    lf.Parent = spaceContainer
                    table.insert(rwConstellationLines, lf)
                end
            end
        end

        local starCount = (wType == "Stars" or wType == "Shooting Stars") and 62 or 45
        for _ = 1, starCount do
            local p = Instance.new("Frame")
            p.BorderSizePixel = 0
            p.AnchorPoint = Vector2.new(0.5, 0.5)
            local sx = math.random(6, math.max(10, winW - 6))
            local sy = math.random(6, math.max(10, winH - 6))
            local roll = math.random(1, 100)
            local sz = (roll <= 65) and 1 or ((roll <= 92) and 1.5 or 2)
            p.Size = UDim2.fromOffset(sz, sz)
            p.BackgroundColor3 = (roll >= 85) and acc:Lerp(Color3.new(1, 1, 1), 0.7) or Color3.fromRGB(255, 255, 255)
            local baseTr = math.random(25, 65) / 100
            p.BackgroundTransparency = baseTr
            p.Position = UDim2.fromOffset(sx, sy)
            p.ZIndex = 2
            p.Active = false
            p.Parent = winLayer
            Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

            table.insert(rwWeatherParticles, {
                Frame = p,
                X = sx,
                Y = sy,
                SpdX = math.random(-2, 2) / 10,
                SpdY = math.random(-2, 2) / 10,
                RotSpd = 0,
                Twinkle = true,
                TwinkleSpeed = math.random(12, 24) / 10,
                TwinklePhase = math.random() * 6.28,
                BaseTrans = baseTr,
                TwinkleAmp = math.random(15, 25) / 100,
                IsWindow = true
            })
        end
    end

    local isOverlayWeather = (wType == "Snow" or wType == "Rain" or wType == "Sakura" or wType == "Leaves")
    if isOverlayWeather then
        local function spawnOverlayParticle(inWindow)
            local p = Instance.new("Frame")
            p.BorderSizePixel = 0
            p.AnchorPoint = Vector2.new(0.5, 0.5)
            local maxW = inWindow and winW or screenW
            local maxH = inWindow and winH or screenH
            local sx = math.random(0, maxW)
            local sy = math.random(0, maxH)
            local spdX, spdY, rotSpd = 0, 0, 0

            if wType == "Snow" then
                local sz = math.random(3, 5)
                p.Size = UDim2.fromOffset(sz, sz)
                p.BackgroundColor3 = Color3.fromRGB(240, 246, 255)
                p.BackgroundTransparency = math.random(20, 48) / 100
                Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
                spdY = math.random(42, 92)
                spdX = math.random(-14, 14)
            elseif wType == "Rain" then
                p.Size = UDim2.fromOffset(1, math.random(10, 17))
                p.BackgroundColor3 = acc:Lerp(Color3.fromRGB(185, 220, 255), 0.7)
                p.BackgroundTransparency = math.random(32, 58) / 100
                spdY = math.random(360, 540)
                spdX = -22
            elseif wType == "Sakura" then
                local sz = math.random(5, 8)
                p.Size = UDim2.fromOffset(sz, math.floor(sz * 0.75))
                p.BackgroundColor3 = Color3.fromRGB(255, 185, 202)
                p.BackgroundTransparency = math.random(16, 40) / 100
                Instance.new("UICorner", p).CornerRadius = UDim.new(0, 3)
                p.Rotation = math.random(0, 360)
                spdY = math.random(48, 86)
                spdX = math.random(14, 38)
                rotSpd = math.random(-50, 50)
            elseif wType == "Leaves" then
                local sz = math.random(5, 8)
                p.Size = UDim2.fromOffset(sz, math.floor(sz * 0.8))
                local cols = { Color3.fromRGB(235, 132, 38), Color3.fromRGB(245, 162, 24), Color3.fromRGB(205, 68, 48) }
                p.BackgroundColor3 = cols[math.random(1, #cols)]
                p.BackgroundTransparency = math.random(14, 36) / 100
                Instance.new("UICorner", p).CornerRadius = UDim.new(0, 2)
                p.Rotation = math.random(0, 360)
                spdY = math.random(45, 88)
                spdX = math.random(-24, 24)
                rotSpd = math.random(-60, 60)
            end

            p.Active = false
            p.Position = UDim2.fromOffset(sx, sy)
            p.ZIndex = 3
            p.Parent = inWindow and winLayer or scrLayer
            table.insert(rwWeatherParticles, {
                Frame = p,
                X = sx,
                Y = sy,
                SpdX = spdX,
                SpdY = spdY,
                RotSpd = rotSpd,
                Twinkle = false,
                IsWindow = inWindow
            })
        end

        for _ = 1, 22 do spawnOverlayParticle(false) end
        for _ = 1, 18 do spawnOverlayParticle(true) end
    end

    local function FireShootingStar()
        if not self.Visible or not mf.Visible then return end
        local topLayer = mf:FindFirstChild("TopWeatherLayer")
        if not topLayer then
            topLayer = Instance.new("Frame")
            topLayer.Name = "TopWeatherLayer"
            topLayer.Size = UDim2.fromScale(1, 1)
            topLayer.Position = UDim2.fromOffset(0, 0)
            topLayer.BackgroundTransparency = 1
            topLayer.BorderSizePixel = 0
            topLayer.ClipsDescendants = true
            topLayer.Active = false
            topLayer.ZIndex = 25
            topLayer.Parent = mf
        end
        topLayer.Visible = true

        local streak = Instance.new("Frame")
        streak.Name = "ShootingStar"
        local sLen = math.random(55, 82)
        streak.Size = UDim2.fromOffset(sLen, 1.5)
        streak.BorderSizePixel = 0
        streak.AnchorPoint = Vector2.new(1, 0.5)
        streak.BackgroundColor3 = (self.Theme and self.Theme.Accent or Color3.new(1, 1, 1)):Lerp(Color3.new(1, 1, 1), 0.65)
        streak.ZIndex = 26

        local grad = Instance.new("UIGradient")
        grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.65, 0.25),
            NumberSequenceKeypoint.new(1, 0)
        })
        grad.Parent = streak

        local spark = Instance.new("Frame")
        spark.Size = UDim2.fromOffset(3, 3)
        spark.Position = UDim2.new(1, 0, 0.5, 0)
        spark.AnchorPoint = Vector2.new(0.5, 0.5)
        spark.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        spark.BorderSizePixel = 0
        spark.ZIndex = 27
        spark.Parent = streak
        Instance.new("UICorner", spark).CornerRadius = UDim.new(1, 0)

        local angle = math.random(142, 152)
        streak.Rotation = angle
        local curW = mf.AbsoluteSize.X > 0 and mf.AbsoluteSize.X or 720
        local curH = mf.AbsoluteSize.Y > 0 and mf.AbsoluteSize.Y or 530
        local startX = math.random(math.floor(curW * 0.25), math.floor(curW * 0.95))
        local startY = math.random(8, math.floor(curH * 0.45))
        streak.Position = UDim2.fromOffset(startX, startY)
        streak.Parent = topLayer

        local rad = math.rad(angle)
        table.insert(rwShootingStars, {
            Frame = streak,
            Spark = spark,
            X = startX,
            Y = startY,
            DirX = math.cos(rad),
            DirY = math.sin(rad),
            Speed = math.random(620, 840),
            Dur = math.random(45, 65) / 100,
            Elapsed = 0
        })
    end

    if showStarBackdrop or wType == "Stars" or wType == "Shooting Stars" then
        FireShootingStar()
    end

    local rwWeatherAcc = 0
    rwWeatherConn = RunService.RenderStepped:Connect(function(dt)
        if not self.Visible or not mf.Visible then return end
        rwWeatherAcc = rwWeatherAcc + dt
        if rwWeatherAcc < 0.033 then return end
        dt = math.min(rwWeatherAcc, 0.1)
        rwWeatherAcc = 0
        screenW = gui.AbsoluteSize.X > 0 and gui.AbsoluteSize.X or 1920
        screenH = gui.AbsoluteSize.Y > 0 and gui.AbsoluteSize.Y or 1080
        winW = mf.AbsoluteSize.X > 0 and mf.AbsoluteSize.X or 720
        winH = mf.AbsoluteSize.Y > 0 and mf.AbsoluteSize.Y or 530
        local t = os.clock()

        if self.OuterStrokeGrad then
            self.OuterStrokeGrad.Rotation = (self.OuterStrokeGrad.Rotation + dt * 10) % 360
        end

        for _, cs in ipairs(rwCrossStars) do
            if cs.Frame and cs.Frame.Parent then
                cs.Frame.Rotation = (cs.Frame.Rotation + dt * cs.Speed) % 360
                local pulse = cs.BasePulse + math.sin(t * 2.2) * 1.8
                cs.RayV.Size = UDim2.fromOffset(1, pulse)
                cs.RayH.Size = UDim2.fromOffset(pulse, 1)
            end
        end

        for idx, lf in ipairs(rwConstellationLines) do
            if lf and lf.Parent then
                lf.BackgroundTransparency = math.clamp(0.76 + math.sin(t * 1.5 + idx * 0.7) * 0.08, 0.66, 0.86)
            end
        end

        if showStarBackdrop or wType == "Stars" or wType == "Shooting Stars" then
            rwShootTimer = rwShootTimer + dt
            local delayTarget = (wType == "Shooting Stars") and 0.9 or rwNextShootDelay
            if rwShootTimer >= delayTarget then
                rwShootTimer = 0
                rwNextShootDelay = math.random(16, 28) / 10
                FireShootingStar()
            end
        end

        for i = #rwShootingStars, 1, -1 do
            local ss = rwShootingStars[i]
            ss.Elapsed = ss.Elapsed + dt
            if ss.Elapsed >= ss.Dur or not ss.Frame.Parent then
                pcall(function() ss.Frame:Destroy() end)
                table.remove(rwShootingStars, i)
            else
                ss.X = ss.X + ss.DirX * ss.Speed * dt
                ss.Y = ss.Y + ss.DirY * ss.Speed * dt
                ss.Frame.Position = UDim2.fromOffset(ss.X, ss.Y)
                if ss.Elapsed > ss.Dur * 0.55 then
                    local fade = (ss.Elapsed - ss.Dur * 0.55) / (ss.Dur * 0.45)
                    ss.Frame.BackgroundTransparency = fade
                    if ss.Spark then ss.Spark.BackgroundTransparency = fade end
                end
            end
        end

        if self.ParallaxEnabled ~= false then
            local mPos = UserInputService:GetMouseLocation()
            local winPos = mf.AbsolutePosition
            local centerX = winPos.X + winW * 0.5
            local centerY = winPos.Y + winH * 0.5
            local inWin = (mPos.X >= winPos.X - 60 and mPos.X <= winPos.X + winW + 60 and mPos.Y >= winPos.Y - 60 and mPos.Y <= winPos.Y + winH + 60)
            local targetX, targetY = 0, 0
            if inWin and winW > 0 and winH > 0 then
                targetX = math.clamp((mPos.X - centerX) / (winW * 0.5), -1.2, 1.2)
                targetY = math.clamp((mPos.Y - centerY) / (winH * 0.5), -1.2, 1.2)
            end
            rwParallaxX = rwParallaxX + (targetX - rwParallaxX) * math.clamp(dt * 7, 0, 1)
            rwParallaxY = rwParallaxY + (targetY - rwParallaxY) * math.clamp(dt * 7, 0, 1)
            winLayer.Position = UDim2.fromOffset(-30 + rwParallaxX * -16, -30 + rwParallaxY * -16)
            if self.CustomBg and self.CustomBg.Visible then
                self.CustomBg.Position = UDim2.fromOffset(-30 + rwParallaxX * -12, -30 + rwParallaxY * -12)
            end
        end

        for i = #rwWeatherParticles, 1, -1 do
            local pt = rwWeatherParticles[i]
            local bW = pt.IsWindow and winW or screenW
            local bH = pt.IsWindow and winH or screenH
            pt.Y = pt.Y + pt.SpdY * dt
            pt.X = pt.X + pt.SpdX * dt
            if pt.RotSpd and pt.RotSpd ~= 0 then
                pt.Frame.Rotation = (pt.Frame.Rotation + pt.RotSpd * dt) % 360
            end
            if pt.Twinkle then
                pt.TwinklePhase = pt.TwinklePhase + dt * pt.TwinkleSpeed
                pt.Frame.BackgroundTransparency = math.clamp(pt.BaseTrans + math.sin(pt.TwinklePhase) * pt.TwinkleAmp, 0.08, 0.92)
            end
            if pt.SpdY < 0 and pt.Y < -15 then
                pt.Y = bH + 10; pt.X = math.random(0, bW)
            elseif pt.SpdY > 0 and pt.Y > bH + 15 then
                pt.Y = -10; pt.X = math.random(0, bW)
            end
            if pt.X < -15 then
                pt.X = bW + 10
            elseif pt.X > bW + 15 then
                pt.X = -10
            end
            pt.Frame.Position = UDim2.fromOffset(pt.X, pt.Y)
        end
    end)
    table.insert(ScriptConnections, rwWeatherConn)
end


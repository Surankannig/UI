        local hs = game:GetService("HttpService")
        local prof = Window.ConfigValues["SelectedConfigName"] or ActiveConfigProfile or "Default"
        if prof == "" then prof = "Default" end
        local data = {}
        for k, v in pairs(Window.ConfigValues) do

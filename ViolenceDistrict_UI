local function SynchronizeConfigState()
    local cv = Window and Window.ConfigValues
    if not cv then return end

    if cv["Thickness"] ~= nil then
        Config.KillerSkeletonThickness = tonumber(cv["Thickness"]) or Config.KillerSkeletonThickness
    elseif cv["Skeleton Line Width"] ~= nil then
        Config.KillerSkeletonThickness = tonumber(cv["Skeleton Line Width"]) or Config.KillerSkeletonThickness
        for _, esp in pairs(ESP_Objects) do
            for _, l in pairs(esp.Skeleton) do l.Thickness = Config.KillerSkeletonThickness end
        end
    end
    if cv["Top Killer Skill Size"] ~= nil then
        Config.TopKillerSkillSize = tonumber(cv["Top Killer Skill Size"]) or Config.TopKillerSkillSize
        TopKillerSkillText.Size = Config.TopKillerSkillSize
    end

    if cv["Pallet Max Distance"] ~= nil then
        Config.PalletMaxDist = tonumber(cv["Pallet Max Distance"]) or Config.PalletMaxDist
    end
    if cv["Window Max Distance"] ~= nil then
        Config.WindowMaxDist = tonumber(cv["Window Max Distance"]) or Config.WindowMaxDist
    end
    if cv["Bear Trap Max Distance"] ~= nil then
        Config.BearTrapMaxDist = tonumber(cv["Bear Trap Max Distance"]) or Config.BearTrapMaxDist
    end
    if cv["Pumpkin Max Distance"] ~= nil then
        Config.PumpkinMaxDist = tonumber(cv["Pumpkin Max Distance"]) or Config.PumpkinMaxDist
    end
    if cv["Pumpkin 3D Aura"] ~= nil then Config.ESP_PumpkinAura = (cv["Pumpkin 3D Aura"] == true) end
    if cv["Pumpkin Name & Distance"] ~= nil then Config.ESP_Pumpkins = (cv["Pumpkin Name & Distance"] == true) end
    if cv["Pumpkin Tracer Line"] ~= nil then Config.ESP_PumpkinTracer = (cv["Pumpkin Tracer Line"] == true) end
    if cv["Auto Crush Nearby Pumpkins"] ~= nil then Config.AutoCrushPumpkin = (cv["Auto Crush Nearby Pumpkins"] == true) end
    if cv["Auto Farm Pumpkins (TP & Crush)"] ~= nil then Config.AutoFarmPumpkins = (cv["Auto Farm Pumpkins (TP & Crush)"] == true) end
    if cv["Field of View (FOV)"] ~= nil then
        Config.FOV = tonumber(cv["Field of View (FOV)"]) or Config.FOV
        if Config.CustomFOVEnabled then
            Camera.FieldOfView = Config.FOV
        end
    end

    if cv["Enable Custom FOV"] ~= nil then
        Config.CustomFOVEnabled = (cv["Enable Custom FOV"] == true)
        if Config.CustomFOVEnabled then
            Camera.FieldOfView = Config.FOV
        end
    end
    if cv["Fullbright (Clear Vision)"] ~= nil then
        Config.Fullbright = (cv["Fullbright (Clear Vision)"] == true)
        if Config.Fullbright then
            if ApplyFullbrightNow then ApplyFullbrightNow() end
        else
            if RestoreOriginalLighting then RestoreOriginalLighting() end
        end
    end

    local function syncCol(flag, def)
        local val = cv[flag .. "_Color"]
        local resolved = def
        if type(val) == "table" and #val >= 3 then
            local r = tonumber(val[1]) or 0
            local g = tonumber(val[2]) or 0
            local b = tonumber(val[3]) or 0
            if r > 1 or g > 1 or b > 1 then
                resolved = Color3.fromRGB(math.clamp(math.floor(r), 0, 255), math.clamp(math.floor(g), 0, 255), math.clamp(math.floor(b), 0, 255))
            else
                resolved = Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
            end
        elseif typeof(val) == "Color3" then
            resolved = val

local LocalKillerLevelCache = {}
local LastKillerLevelQuery = {}

local function GetResolvedKillerLevel(plr, kType)
    local cleanK = tostring(kType or "Killer"):gsub("^The%s+", "")
    local char = plr and plr.Character
    local attrLvl = (char and (char:GetAttribute("KillerLevel") or char:GetAttribute("Level") or char:GetAttribute(cleanK .. "Level")))
                 or (plr and (plr:GetAttribute("KillerLevel") or plr:GetAttribute(cleanK .. "Level")))
    if type(attrLvl) == "number" and attrLvl > 0 then
        return attrLvl
    end

    if plr == LocalPlayer then
        local now = os.clock()
        if not LocalKillerLevelCache[cleanK] or (now - (LastKillerLevelQuery[cleanK] or 0) > 15) then
            LastKillerLevelQuery[cleanK] = now
            task.spawn(function()
                pcall(function()
                    local sk = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("ShopKillers")
                    local gkl = sk and sk:FindFirstChild("GetKillerLevel")
                    if gkl and gkl:IsA("RemoteFunction") then
                        local lv = gkl:InvokeServer(cleanK)
                        if type(lv) == "number" and lv > 0 then
                            LocalKillerLevelCache[cleanK] = lv
                        end
                    end
                end)
            end)
        end
        if LocalKillerLevelCache[cleanK] then
            return LocalKillerLevelCache[cleanK]
        end
        local ok, guiLv = pcall(function()
            local inv = LocalPlayer.PlayerGui:FindFirstChild("Spectator") and LocalPlayer.PlayerGui.Spectator:FindFirstChild("Inventory")
            local blk = inv and inv:FindFirstChild("Browse_loadout_killer")
            local sel = inv and inv:FindFirstChild("SelectedKiller")
            if blk and sel and tostring(sel.Value):lower() == cleanK:lower() then
                local lbl = blk:FindFirstChild("LevelLabel")
                local num = lbl and tonumber(tostring(lbl.Text):match("(%d+)"))
                return num
            end
            return nil
        end)
        if ok and guiLv and guiLv > 0 then
            LocalKillerLevelCache[cleanK] = guiLv
            return guiLv
        end
    end

    return tonumber(plr and plr:GetAttribute("Level")) or 1
end

local function UpdateRoster(force)
    local allPlayers = Players:GetPlayers()
    local killerPlr = nil
    local survivors = {}

    for _, p in ipairs(allPlayers) do
        if not killerPlr and IsKiller(p) then
            killerPlr = p
        else
            table.insert(survivors, p)
        end
    end

    local inLobby = IsInLobby()
    RosterTitle.Text = "Match Info Beta"

    for p, row in pairs(cachedRosterRows) do
        if not table.find(allPlayers, p) then
            pcall(function() row.Card:Destroy() end)
            cachedRosterRows[p] = nil
        end
    end

    local ordered = {}
    if killerPlr then
        table.insert(ordered, killerPlr)
    end
    if table.find(survivors, LocalPlayer) then
        table.insert(ordered, LocalPlayer)
    end
    table.sort(survivors, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    for _, s in ipairs(survivors) do
        if s ~= LocalPlayer and not table.find(ordered, s) then
            table.insert(ordered, s)
        end
    end

    for rank, plr in ipairs(ordered) do
        local ok, err = pcall(function()
            local row = cachedRosterRows[plr] or CreatePlayerRow(plr)
            row.Card.LayoutOrder = rank
            local isK = (plr == killerPlr)
            local kType = nil

        local plrLevel = tonumber(plr:GetAttribute("Level")) or 1
        local rawPlat = tostring(plr:GetAttribute("platform") or "PC")
        local platUpper = rawPlat:upper()
        local platDisplay = (platUpper == "MOBILE" and "MOBILE") or (platUpper == "CONSOLE" and "CONSOLE") or "PC"

        if isK then
            local kCol = Color3.fromRGB(255, 60, 80)
            row.AccentBar.BackgroundColor3 = kCol
            row.AvatarStroke.Color = kCol
            row.AvatarBox.BackgroundColor3 = Color3.fromRGB(45, 15, 20)

            kType = ResolveKillerType(plr)
            local cleanK = tostring(kType or "Killer"):gsub("^The%s+", "")
            local kLevel = GetResolvedKillerLevel(plr, kType)

            SetupKillerAvatar(row, kType, plr)

            if row.LvlBadge then
                row.LvlBadge.BackgroundColor3 = Color3.fromRGB(42, 12, 18)
                row.LvlStroke.Color = kCol
                row.LvlText.Text = tostring(kLevel)

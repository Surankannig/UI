        return
    end
    if shouldShowWarn then
        warnAlpha = math.min(1, warnAlpha + dt * 5.5)
        warnSlideOffset = warnSlideOffset + (0 - warnSlideOffset) * math.clamp(dt * 12, 0, 1)

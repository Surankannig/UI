            row.ItemHeader.Visible = true
            row.ItemBox.Visible = true
            row.ItemHeader.Text = "EQUIPPED ITEM"
            row.ItemStroke.Color = Color3.fromRGB(255, 180, 50)
        end

        if row.PlatPill and row.PlatText then

        LegitWarnBanner.Position = UDim2.fromOffset(math.floor(absPos.X - guiAbs.X), math.floor(absPos.Y - guiAbs.Y - 36 + warnSlideOffset))
    end

    LegitWarnBanner.BackgroundTransparency = 1 - (0.94 * warnAlpha)
    warnStroke.Transparency = 1 - (0.68 * warnAlpha)

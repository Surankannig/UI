            local pLbl = row.PerkLabels[i]

            if pb then pb.Visible = true end
            if pName and pName ~= "" and pName ~= "---" then
                local pTier = (PlayerPerkTiers[plr] and PlayerPerkTiers[plr][pName]) or (plr and plr.UserId and PlayerPerkTiers[plr.UserId] and PlayerPerkTiers[plr.UserId][pName]) or 3
                local pIcon = GetPerkIcon(pName, pTier) or "rbxassetid://115375812494391"
